# Copy to .env if you want to override local defaults.
# Snagline runs on SQLite when POSTGRES_DB is empty.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Postgres. Leave POSTGRES_DB blank to keep SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional. The Vite dev server proxies /api when this is unset.
# VITE_API_URL=http://127.0.0.1:8000/api
